    "supplemental_discoveries_are_research_only": true
  },
  "emerging_growth_watchlist": {
    "source_name": "watchlist_non_sp500",
    "maximum_initial_target_weight": "0.03",
    "maximum_aggregate_target_weight": "0.10",
    "require_staged_entry": true,
    "require_primary_source_research": true,
    "allow_zero_allocation": true
  },
  "valuation_requirements": {
    "separate_price_from_value": true,
    "allow_no_reliable_estimate": true,
    "require_scenario_range": true,
    "require_source_or_input_reference": true,
    "forbid_price_decline_as_sole_undervaluation_evidence": true
  },
  "accumulation_requirements": {
    "allow_immediate_full_entry": true,
    "allow_staged_entry": true,
    "allow_wait": true,
    "maximum_planned_tranches": 5,
    "do_not_average_down_after_thesis_break": true
  }
