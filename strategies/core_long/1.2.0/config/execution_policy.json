    "time_in_force": "gtc",
    "execution_fraction": "1",
    "require_fresh_quote": false
  },
  "closed_session_queue": {
    "enabled": true,
    "require_limit_intent": true,
    "time_in_force": "day",
    "extended_hours_requested": false,
    "maximum_open_execution_fraction": "0.25",
    "maximum_reduce_execution_fraction": "1.00",
    "quote_max_age_seconds": "345600"
  }
