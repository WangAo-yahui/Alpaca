    "maximum_relative_change": "0.25"
  },
  "execution_fraction": {
    "minimum": "0",
    "maximum": "1"
  },
  "position_protection": {
    "enabled": true,
    "codex_strategy_selection_enabled": true,
    "require_plan_for_existing_long_equity": true,
    "require_plan_for_approved_entry": true,
    "default_coverage_fraction": "1",
    "minimum_coverage_fraction": "0.10",
    "maximum_coverage_fraction": "1",
    "minimum_stop_distance_fraction": "0.003",
    "maximum_stop_distance_fraction": "0.30",
    "minimum_take_profit_distance_fraction": "0.005",
    "maximum_take_profit_distance_fraction": "2.00",
    "minimum_trail_percent": "0.5",
    "maximum_trail_percent": "30",
    "maximum_stages": 5,
    "allow_dynamic_replacement": true,
    "allow_modes": [
      "stop",
      "stop_limit",
      "take_profit",
      "trailing_stop",
      "oco",
      "bracket",
      "oto_stop",
      "oto_take_profit",
      "staged_oco"
