{
  "_comment": "作用：定义 Stage E 的长期组合执行、分批建仓、低换手和可选保护边界。重要性：给 Codex 较高配置自由度，但仍由 Python 保证账户、报价、幂等、禁止做空和禁止杠杆。",
  "schema_version": "1.0",
  "valid_minutes": 30,
  "target_weight_adjustment": {
    "maximum_absolute_change": "0.02",
    "maximum_relative_change": "0.25"
  },
  "execution_fraction": {
    "minimum": "0",
    "maximum": "1"
  },
  "position_protection": {
    "enabled": true,
    "codex_strategy_selection_enabled": true,
    "require_plan_for_existing_long_equity": true,
    "require_plan_for_approved_entry": true,
    "default_coverage_fraction": "1",
    "minimum_coverage_fraction": "0.10",
    "maximum_coverage_fraction": "1",
    "minimum_stop_distance_fraction": "0.003",
    "maximum_stop_distance_fraction": "0.30",
    "minimum_take_profit_distance_fraction": "0.005",
    "maximum_take_profit_distance_fraction": "2.00",
    "minimum_trail_percent": "0.5",
    "maximum_trail_percent": "30",
    "maximum_stages": 5,
    "allow_dynamic_replacement": true,
    "allow_none_when_thesis_based": true,
    "allow_modes": [
      "none",
      "stop",
      "stop_limit",
      "take_profit",
      "trailing_stop",
      "oco",
      "bracket",
      "oto_stop",
      "oto_take_profit",
      "staged_oco"
    ]
  },
  "long_horizon_execution": {
    "minimum_material_weight_gap": "0.01",
    "avoid_repeated_same_day_micro_orders": true,
    "maximum_discretionary_entries_per_symbol_per_day": 2,
    "prefer_limit_for_non_urgent_entries": true,
    "allow_full_entry_when_value_evidence_is_strong": true,
    "allow_zero_execution_when_edge_is_weak": true,
    "automatic_stop_is_not_mandatory": true
  },
  "extended_hours": {
    "require_limit_intent": true,
    "require_fresh_quote": true
  },
  "crypto_liquidation": {
    "enabled": true,
    "environment": "live",
    "order_type": "market",
    "time_in_force": "gtc",
    "execution_fraction": "1",
    "require_fresh_quote": false
  },
  "closed_session_queue": {
    "enabled": true,
    "require_limit_intent": true,
    "time_in_force": "day",
    "extended_hours_requested": false,
    "maximum_open_execution_fraction": "0.25",
    "maximum_reduce_execution_fraction": "1.00",
    "quote_max_age_seconds": "345600"
  }
}
