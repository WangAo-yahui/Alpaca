{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wa-trader.local/schemas/v2/coarse_output.schema.json",
  "title": "WA Trader v2 coarse selection output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "run_date",
    "generated_at",
    "input_signature",
    "status",
    "network_research",
    "market_summary",
    "selection_count",
    "selections",
    "warnings",
    "source_references"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "stage": {
      "type": "string",
      "const": "coarse_selection"
    },
    "run_date": {
      "type": "string",
      "minLength": 10
    },
    "generated_at": {
      "type": "string",
      "minLength": 10
    },
    "input_signature": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "success_local_only"
      ]
    },
    "network_research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "web_access",
        "summary",
        "warnings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "unavailable",
            "not_requested"
          ]
        },
        "web_access": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "market_summary": {
      "type": "string",
      "minLength": 1
    },
    "selection_count": {
      "type": "integer",
      "const": 60
    },
    "selections": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "symbol",
          "asset_type",
          "sector",
          "industry",
          "research_eligible",
          "screen_new_position_eligible",
          "selection_reason",
          "main_risks",
          "key_factors",
          "source_references"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "stock",
              "etf"
            ]
          },
          "sector": {
            "type": [
              "string",
              "null"
            ]
          },
          "industry": {
            "type": [
              "string",
              "null"
            ]
          },
          "research_eligible": {
            "type": "boolean"
          },
          "screen_new_position_eligible": {
            "type": "boolean"
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "main_risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key_factors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "source_type",
          "retrieved_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "web",
              "input",
              "local"
            ]
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
