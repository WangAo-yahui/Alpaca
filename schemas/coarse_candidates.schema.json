{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "generated_at",
    "market_view",
    "network_research",
    "selection_count",
    "required_symbols_covered",
    "concentration_assessment",
    "selected",
    "notable_rejections",
    "research_files",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "coarse_selection"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "market_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "summary",
        "risk_level"
      ],
      "properties": {
        "regime": {
          "type": "string",
          "enum": [
            "bullish",
            "neutral",
            "cautious",
            "bearish"
          ]
        },
        "summary": {
          "type": "string"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "extreme"
          ]
        }
      }
    },
    "network_research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "status",
        "summary",
        "repair_attempts"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "local_only"
          ]
        },
        "summary": {
          "type": "string"
        },
        "repair_attempts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "selection_count": {
      "type": "integer",
      "enum": [
        60
      ]
    },
    "required_symbols_covered": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "concentration_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_materially_concentrated",
        "summary",
        "largest_group",
        "largest_group_count"
      ],
      "properties": {
        "is_materially_concentrated": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "largest_group": {
          "type": "string"
        },
        "largest_group_count": {
          "type": "integer"
        }
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "notable_rejections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rejection"
      }
    },
    "research_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "candidate_type",
        "sector_or_category",
        "selection_reason",
        "primary_risks",
        "research_priority",
        "forced_include",
        "research_eligible",
        "screen_new_position_eligible",
        "source_references"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "candidate_type": {
          "type": "string",
          "enum": [
            "benchmark",
            "current_position",
            "order_management",
            "trend",
            "relative_strength",
            "quality_pullback",
            "value_recovery",
            "defensive",
            "sector_rotation",
            "macro_hedge",
            "special_situation"
          ]
        },
        "sector_or_category": {
          "type": "string"
        },
        "selection_reason": {
          "type": "string"
        },
        "primary_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "research_priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "forced_include": {
          "type": "boolean"
        },
        "research_eligible": {
          "type": "boolean"
        },
        "screen_new_position_eligible": {
          "type": "boolean"
        },
        "source_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "reason"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}