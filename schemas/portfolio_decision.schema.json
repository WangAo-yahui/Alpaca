{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wa-trader/schemas/portfolio_decision.schema.json",
  "title": "WA Trader v1 Portfolio Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "generated_at",
    "run_date",
    "run_mode",
    "network_research",
    "data_quality",
    "market_assessment",
    "portfolio_strategy",
    "position_decisions",
    "pending_order_reviews",
    "watchlist",
    "portfolio_risks",
    "summary",
    "warnings",
    "source_references",
    "research_files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "portfolio_decision"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "run_date": {
      "type": "string"
    },
    "run_mode": {
      "type": "string",
      "enum": [
        "before_market_open",
        "regular_session",
        "after_market_close",
        "market_closed_weekend",
        "market_closed_holiday",
        "delayed_data_unavailable"
      ]
    },
    "network_research": {
      "$ref": "#/$defs/network_research"
    },
    "data_quality": {
      "$ref": "#/$defs/data_quality"
    },
    "market_assessment": {
      "$ref": "#/$defs/market_assessment"
    },
    "portfolio_strategy": {
      "$ref": "#/$defs/portfolio_strategy"
    },
    "position_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position_decision"
      }
    },
    "pending_order_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pending_order_review"
      }
    },
    "watchlist": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/watch_item"
      }
    },
    "portfolio_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/portfolio_risk"
      }
    },
    "summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_reference"
      }
    },
    "research_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "symbol": {
      "type": "string"
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "title",
        "location",
        "published_at",
        "used_for"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "local_input",
            "official_company",
            "sec_filing",
            "government",
            "central_bank",
            "exchange",
            "reputable_media",
            "other_public_source"
          ]
        },
        "title": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        },
        "used_for": {
          "type": "string"
        }
      }
    },
    "network_research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "status",
        "summary",
        "repair_attempts",
        "new_positions_permitted_by_research_status"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "local_only"
          ]
        },
        "summary": {
          "type": "string"
        },
        "repair_attempts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new_positions_permitted_by_research_status": {
          "type": "boolean"
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_snapshot_available",
        "positions_snapshot_available",
        "open_orders_snapshot_available",
        "daily_data_complete_count",
        "intraday_success_count",
        "intraday_no_data_count",
        "intraday_failed_count",
        "intraday_data_required_for_decision",
        "intraday_absence_interpretation",
        "overall_status",
        "limitations"
      ],
      "properties": {
        "account_snapshot_available": {
          "type": "boolean"
        },
        "positions_snapshot_available": {
          "type": "boolean"
        },
        "open_orders_snapshot_available": {
          "type": "boolean"
        },
        "daily_data_complete_count": {
          "type": "integer"
        },
        "intraday_success_count": {
          "type": "integer"
        },
        "intraday_no_data_count": {
          "type": "integer"
        },
        "intraday_failed_count": {
          "type": "integer"
        },
        "intraday_data_required_for_decision": {
          "type": "boolean"
        },
        "intraday_absence_interpretation": {
          "type": "string"
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "complete",
            "usable_with_limitations",
            "insufficient"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "market_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "regime",
        "confidence",
        "benchmark",
        "breadth_assessment",
        "volatility_assessment",
        "macro_assessment",
        "thesis",
        "key_risks"
      ],
      "properties": {
        "view": {
          "type": "string",
          "enum": [
            "bullish",
            "neutral",
            "cautious",
            "bearish"
          ]
        },
        "regime": {
          "type": "string",
          "enum": [
            "risk_on",
            "selective_risk_on",
            "mixed",
            "risk_off",
            "high_uncertainty"
          ]
        },
        "confidence": {
          "type": "number"
        },
        "benchmark": {
          "type": "string",
          "enum": [
            "SPY"
          ]
        },
        "breadth_assessment": {
          "type": "string"
        },
        "volatility_assessment": {
          "type": "string"
        },
        "macro_assessment": {
          "type": "string"
        },
        "thesis": {
          "type": "string"
        },
        "key_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "portfolio_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_cash_weight",
        "target_invested_weight",
        "target_position_count",
        "turnover_preference",
        "concentration_posture",
        "new_position_policy",
        "existing_position_policy",
        "rationale"
      ],
      "properties": {
        "target_cash_weight": {
          "type": "number"
        },
        "target_invested_weight": {
          "type": "number"
        },
        "target_position_count": {
          "type": "integer"
        },
        "turnover_preference": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "moderate",
            "high_only_if_necessary"
          ]
        },
        "concentration_posture": {
          "type": "string",
          "enum": [
            "diversified",
            "selectively_concentrated",
            "defensive",
            "cash_heavy"
          ]
        },
        "new_position_policy": {
          "type": "string",
          "enum": [
            "allowed_for_research_only",
            "propose_when_supported",
            "do_not_propose"
          ]
        },
        "existing_position_policy": {
          "type": "string",
          "enum": [
            "hold_bias",
            "selective_adjustment",
            "active_risk_reduction",
            "full_reassessment"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "entry_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "style",
        "reference_price",
        "preferred_limit_price",
        "maximum_acceptable_price",
        "staging_steps",
        "time_horizon",
        "notes"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "style": {
          "type": "string",
          "enum": [
            "none",
            "immediate_reference",
            "passive_pullback",
            "breakout_confirmation",
            "staged_entry"
          ]
        },
        "reference_price": {
          "type": "number"
        },
        "preferred_limit_price": {
          "type": "number"
        },
        "maximum_acceptable_price": {
          "type": "number"
        },
        "staging_steps": {
          "type": "integer"
        },
        "time_horizon": {
          "type": "string",
          "enum": [
            "same_session",
            "several_sessions",
            "several_weeks",
            "not_applicable"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "risk_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "stop_style",
        "stop_reference",
        "take_profit_style",
        "take_profit_reference",
        "trailing_percent",
        "thesis_break_condition",
        "maximum_portfolio_loss_weight",
        "notes"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "none",
            "add_initial_protection",
            "keep_existing_protection",
            "replace_protection",
            "tighten_protection",
            "loosen_protection",
            "exit_on_thesis_break"
          ]
        },
        "stop_style": {
          "type": "string",
          "enum": [
            "none",
            "fixed_price",
            "percent_below_reference",
            "atr_based",
            "trailing_percent",
            "technical_level"
          ]
        },
        "stop_reference": {
          "type": "number"
        },
        "take_profit_style": {
          "type": "string",
          "enum": [
            "none",
            "fixed_price",
            "scale_out",
            "trailing",
            "valuation_or_thesis"
          ]
        },
        "take_profit_reference": {
          "type": "number"
        },
        "trailing_percent": {
          "type": "number"
        },
        "thesis_break_condition": {
          "type": "string"
        },
        "maximum_portfolio_loss_weight": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "position_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "current_position_state",
        "current_quantity",
        "research_eligible",
        "screen_new_position_eligible",
        "decision",
        "priority",
        "target_weight",
        "maximum_weight",
        "proposed_new_position",
        "requires_fresh_intraday_confirmation",
        "entry_plan",
        "risk_plan",
        "thesis",
        "catalysts",
        "risks",
        "reason",
        "source_references"
      ],
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "current_position_state": {
          "type": "string",
          "enum": [
            "zero",
            "long",
            "short"
          ]
        },
        "current_quantity": {
          "type": "number"
        },
        "research_eligible": {
          "type": "boolean"
        },
        "screen_new_position_eligible": {
          "type": "boolean"
        },
        "decision": {
          "type": "string",
          "enum": [
            "open",
            "increase",
            "hold",
            "reduce",
            "close",
            "protect",
            "replace_protection",
            "watch",
            "avoid"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "target_weight": {
          "type": "number"
        },
        "maximum_weight": {
          "type": "number"
        },
        "proposed_new_position": {
          "type": "boolean"
        },
        "requires_fresh_intraday_confirmation": {
          "type": "boolean"
        },
        "entry_plan": {
          "$ref": "#/$defs/entry_plan"
        },
        "risk_plan": {
          "$ref": "#/$defs/risk_plan"
        },
        "thesis": {
          "type": "string"
        },
        "catalysts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "source_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_reference"
          }
        }
      }
    },
    "pending_order_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "order_identity",
        "recommendation",
        "replacement_needed",
        "reason"
      ],
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "order_identity": {
          "type": "string"
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "keep",
            "cancel",
            "replace",
            "manual_review"
          ]
        },
        "replacement_needed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "watch_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "status",
        "trigger",
        "reason"
      ],
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "status": {
          "type": "string",
          "enum": [
            "watch_for_entry",
            "watch_for_add",
            "watch_for_reduce",
            "watch_for_exit",
            "avoid_until_research"
          ]
        },
        "trigger": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "portfolio_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_type",
        "severity",
        "description",
        "mitigation"
      ],
      "properties": {
        "risk_type": {
          "type": "string",
          "enum": [
            "market",
            "sector",
            "correlation",
            "liquidity",
            "event",
            "volatility",
            "data_quality",
            "execution",
            "other"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "description": {
          "type": "string"
        },
        "mitigation": {
          "type": "string"
        }
      }
    }
  }
}
