{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "broker_submission.schema.json",
  "$comment": "作用：约束本轮所有 submit/cancel 的脱敏结果。重要性：它区分已提交、既有、明确失败和不确定状态，禁止把请求当作成交。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "environment",
    "run_date",
    "cycle_id",
    "started_at",
    "completed_at",
    "submission_requested",
    "submission_performed",
    "validated_orders_hash",
    "submitted_count",
    "existing_count",
    "rejected_count",
    "uncertain_count",
    "cancel_requested_count",
    "cancel_confirmed_count",
    "operations",
    "global_errors",
    "global_warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "environment": {"enum": ["paper", "live"]},
    "run_date": {"type": "string"},
    "cycle_id": {"type": "string"},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "submission_requested": {"type": "boolean"},
    "submission_performed": {"type": "boolean"},
    "validated_orders_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "submitted_count": {"type": "integer", "minimum": 0},
    "existing_count": {"type": "integer", "minimum": 0},
    "rejected_count": {"type": "integer", "minimum": 0},
    "uncertain_count": {"type": "integer", "minimum": 0},
    "cancel_requested_count": {"type": "integer", "minimum": 0},
    "cancel_confirmed_count": {"type": "integer", "minimum": 0},
    "operations": {"type": "array", "items": {"type": "object"}},
    "global_errors": {"type": "array"},
    "global_warnings": {"type": "array"}
  }
}
