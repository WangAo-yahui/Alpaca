{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cycle_summary.schema.json",
  "$comment": "作用：约束 Stage G 最终 cycle 摘要。重要性：它把决策、订单、成交、资本和最终状态汇成可审计的单一入口。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "strategy_id",
    "strategy_version",
    "run_date",
    "cycle_id",
    "cycle_kind",
    "started_at",
    "completed_at",
    "final_status",
    "coarse",
    "portfolio",
    "execution",
    "orders",
    "capital",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string"},
    "strategy_id": {"type": "string"},
    "strategy_version": {"type": "string"},
    "run_date": {"type": "string"},
    "cycle_id": {"type": "string"},
    "cycle_kind": {"type": "string"},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "final_status": {"type": "string"},
    "coarse": {"type": "object"},
    "portfolio": {"type": "object"},
    "execution": {"type": "object"},
    "orders": {"type": "object"},
    "capital": {"type": "object"},
    "warnings": {"type": "array"},
    "errors": {"type": "array"}
  }
}
