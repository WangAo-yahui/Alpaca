{
  "_comment": "作用：授权 live1 通过经过校验的唯一写路径提交和取消 Alpaca Live 订单。重要性：开放全部账户权益不等于绕过幂等、写前日志、账户绑定或不确定结果停止规则。",
  "schema_version": "1.0",
  "policy_id": "alpaca_live",
  "version": "1.0.0",
  "broker": "alpaca",
  "environment": "live",
  "allow_submit": true,
  "allow_cancel": true,
  "allow_direct_replace": false,
  "submit_orders_sequentially": true,
  "stop_after_uncertain_write": true,
  "status_poll": {
    "enabled": true,
    "initial_seconds": 1,
    "maximum_seconds": 10,
    "interval_seconds": 1
  },
  "write_retry": {
    "blind_retry_count": 0,
    "lookup_by_client_order_id_after_error": true
  },
  "immediate_reconciliation": true,
  "persist_before_each_write": true,
  "persist_after_each_response": true,
  "broker_capability_adapter": {
    "sdk": "alpaca-py",
    "submit_method": "submit_order(OrderRequest)",
    "idempotency_lookup": "get_order_by_client_id",
    "cancel_method": "cancel_order_by_id",
    "extended_hours_order_type": "limit",
    "extended_hours_time_in_force": [
      "day",
      "gtc"
    ],
    "overnight_tradable_field": "overnight_tradable",
    "overnight_halted_field": "overnight_halted",
    "fail_closed_when_overnight_capability_missing": true,
    "fractional_quantity_max_decimals": 9
  },
  "deployment_switches": {
    "paper_submission_enabled": false,
    "live_submission_enabled": true,
    "cancel_enabled": true,
    "protective_order_submission_enabled": true,
    "emergency_stop": false,
    "global_kill_switch": false
  }
}
