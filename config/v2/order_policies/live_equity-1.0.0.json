{
  "_comment": "作用：集中定义 Alpaca Live 美股订单、精度、TIF、扩展时段和幂等能力。重要性：Live 下单完整复用 Paper 请求构建，但环境身份与凭据严格独立。",
  "schema_version": "1.0",
  "order_policy_id": "live_equity",
  "order_policy_version": "1.0.0",
  "broker": "alpaca",
  "environment": "live",
  "supported_asset_classes": [
    "us_equity",
    "crypto"
  ],
  "supported_order_types": {
    "regular_session": [
      "market",
      "limit",
      "stop",
      "stop_limit",
      "trailing_stop"
    ],
    "extended_hours": [
      "limit"
    ],
    "crypto": [
      "market",
      "limit"
    ]
  },
  "default_time_in_force": "day",
  "supported_time_in_force": [
    "day",
    "gtc"
  ],
  "fractional_quantity_precision": 6,
  "price_precision": 2,
  "protective_orders": {
    "enabled": true,
    "codex_may_select": true,
    "supported_order_classes": [
      "simple",
      "bracket",
      "oco",
      "oto"
    ],
    "supported_simple_types": [
      "limit",
      "stop",
      "stop_limit",
      "trailing_stop"
    ],
    "fractional_supported_types": [
      "limit",
      "stop",
      "stop_limit"
    ],
    "fractional_time_in_force": [
      "day"
    ],
    "advanced_orders_extended_hours": false,
    "trailing_stop_regular_session_only": true,
    "trailing_stop_single_order_only": true,
    "allow_automatic_cancel_replace": true,
    "maximum_stages": 5
  },
  "idempotency_version": "1",
  "client_order_id_max_length": 48,
  "extended_hours": {
    "require_limit": true,
    "supported_time_in_force": [
      "day"
    ],
    "market_phases": [
      "overnight_session",
      "before_market_open",
      "after_market_close"
    ]
  },
  "crypto": {
    "existing_positions_only": true,
    "allow_new_positions": false,
    "liquidate_existing_positions_on_detection": true,
    "liquidation_order_type": "market",
    "liquidation_time_in_force": "gtc",
    "require_fresh_quote_for_liquidation": false,
    "supported_time_in_force": [
      "gtc",
      "ioc"
    ],
    "extended_hours": false
  },
  "queue_policy": {
    "market_closed_weekend": true,
    "market_closed_holiday": true,
    "unknown": false
  },
  "closed_session_queue": {
    "supported_order_types": [
      "limit"
    ],
    "supported_time_in_force": [
      "day"
    ],
    "extended_hours": false,
    "maximum_open_execution_fraction": "0.25",
    "maximum_reduce_execution_fraction": "1.00"
  },
  "broker_capabilities": {
    "supports_fractional_market_day": true,
    "supports_fractional_limit_day": true,
    "supports_extended_hours": true,
    "supports_closed_session_queue": true,
    "supports_crypto_24_7": true,
    "supports_stop": true,
    "supports_stop_limit": true,
    "supports_trailing_stop": true,
    "supports_bracket": true,
    "supports_oco": true,
    "supports_oto": true
  }
}
